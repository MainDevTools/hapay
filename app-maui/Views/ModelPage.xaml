<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.ModelPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:models="clr-namespace:Hapay.Models"
    xmlns:ctl="clr-namespace:Hapay.Controls"
    xmlns:beh="clr-namespace:Hapay.Behaviors"
    x:Name="Page"
    x:DataType="vm:ModelViewModel"
    Title="Модель">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <ActivityIndicator IsRunning="{Binding Loading}" IsVisible="{Binding Loading}"
                               HorizontalOptions="Center" />
            <Label Style="{StaticResource Caption}" IsVisible="{Binding HasError}"
                   Text="{Binding Error, StringFormat='Не вдалося завантажити: {0}'}" />

            <VerticalStackLayout Spacing="12" IsVisible="{Binding Ready}">

                <Border Style="{StaticResource Thumb}" HeightRequest="180" Padding="12">
                    <Grid>
                        <ctl:GlyphView GlyphKey="box" IsVisible="{Binding Card.NoImage}"
                                       HeightRequest="48" WidthRequest="48"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       GlyphColor="{AppThemeBinding Light={StaticResource IndicatorLight}, Dark={StaticResource IndicatorDark}}" />
                        <Image Source="{Binding Card.ImageUrl}" Aspect="AspectFit"
                               AutomationProperties.IsInAccessibleTree="False" />
                    </Grid>
                </Border>

                <Label Style="{StaticResource H1}" Text="{Binding Card.Title}" />
                <Label Style="{StaticResource Caption}" Text="{Binding Card.Category}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" FontSize="{StaticResource F6}" FontAttributes="Bold"
                           Text="{Binding Card.RangeText}"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDarkC}}" />
                    <Label Grid.Column="1" Style="{StaticResource Caption}" VerticalOptions="End"
                           Text="{Binding Card.StoresText}" />
                </Grid>

                <!-- ⚠ Це твердження мусить стояти ПОРУЧ зі списком, а не в підвалі:
                     мітка перевірки завжди про КОНКРЕТНОГО продавця. Закон говорить про
                     мінімум за 30 днів у цього продавця, тож «модельного» вердикту не
                     існує, і жодна цифра тут його не замінює. -->
                <Label Style="{StaticResource Caption}"
                       Text="Це одна модель, зібрана з кількох крамниць. Перевірка знижки завжди стосується окремої крамниці — спільного вердикту на модель не буває." />

                <Label Style="{StaticResource H2}" Text="Де купити" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Offers}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ModelOffer">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Border.Behaviors>
                                    <beh:PressFeedback />
                                </Border.Behaviors>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenOfferCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource Body}"
                                           FontAttributes="Bold" Text="{Binding Store}" />
                                    <Label Grid.Row="0" Grid.Column="1" FontAttributes="Bold"
                                           FontSize="{StaticResource F4}" Text="{Binding PriceText}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDarkC}}" />
                                    <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}"
                                           IsVisible="{Binding HasBadge}" Text="{Binding BadgeLine}" />
                                    <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}"
                                           IsVisible="{Binding IsBest}" Text="{Binding BestText}"
                                           TextColor="{AppThemeBinding Light={StaticResource SaveFgLight}, Dark={StaticResource SaveFgDark}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
