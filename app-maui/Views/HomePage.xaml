<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.HomePage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:models="clr-namespace:Hapay.Models"
    xmlns:conv="clr-namespace:Hapay.Converters"
    x:DataType="vm:HomeViewModel"
    Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
        <conv:InvertBoolConverter x:Key="Invert" />
    </ContentPage.Resources>

    <!-- «Стеження» пішло в таб-бар (UX-пакет 2026-07-24) — тулбар без дублів -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Акаунт" Command="{Binding AccountCommand}"
                     IconImageSource="{AppThemeBinding Light=ic_account_light.png, Dark=ic_account_dark.png}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- панель: пошук + категорія (повна ширина — найдовші підписи, без обрізання) + сорт|ціна -->
        <!-- Панель свідомо в ДВА рядки, не в чотири: раніше фільтри з'їдали ~38% першого
             екрана, і людина, яка відкрила категорію подивитись товари, бачила панель
             керування. Категорія тепер в одному рядку з сортуванням і ціною — назву
             обраної категорії й так видно в заголовку сторінки. -->
        <VerticalStackLayout Grid.Row="0" Padding="12,8" Spacing="8">
            <Border Style="{StaticResource FilterBar}">
                <VerticalStackLayout Spacing="2">
                    <SearchBar Placeholder="Пошук за назвою…" Text="{Binding SearchText}" />
                    <Grid ColumnDefinitions="1.5*,*" ColumnSpacing="6">
                        <!-- Категорія: НЕ плоский пікер (171 рядок — колесо непридатне),
                             а кнопка → повноекранний «Каталог товарів» (розділи →
                             категорії, E-Katalog-стиль — рішення оператора 2026-07-24) -->
                        <Grid Grid.Column="0" ColumnDefinitions="*,Auto" Padding="4,10"
                              SemanticProperties.Hint="Відкриває каталог для вибору категорії">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCategoryPickerCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{Binding SelectedCategoryLabel}"
                                   FontSize="13" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="▾" FontSize="13" VerticalOptions="Center"
                                   AutomationProperties.IsInAccessibleTree="False"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                        </Grid>
                        <Picker Grid.Column="1" Title="Ціна" FontSize="13"
                                ItemsSource="{Binding PriceOptions}"
                                ItemDisplayBinding="{Binding Label}"
                                SelectedItem="{Binding SelectedPrice}" />
                    </Grid>
                    <!-- сорт — сегмент-чіпами + чіп «Підтверджені» попереду -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="6" Padding="2,0,2,4">
                        <!-- «✓ Підтверджені»: знижки, що пройшли перевірку 30-денним
                             мінімумом; окремий тогл, стилістично відмінний від сорту -->
                        <Border Padding="10,4" StrokeShape="RoundRectangle 14" StrokeThickness="0.8"
                                Stroke="{AppThemeBinding Light={StaticResource SaveFgLight}, Dark={StaticResource SaveFgDark}}"
                                BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding OnlyVerified}" Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource SaveFgLight}, Dark={StaticResource SaveFgDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleVerifiedCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="✓ Підтверджені" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource SaveFgLight}, Dark={StaticResource SaveFgDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding OnlyVerified}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <!-- «⚠ Завищена стара ціна»: знижки, де «стару» ціну не
                             підтверджує 30-денний мінімум. Це ФАКТ про ціну (та сама
                             мова, що на картці), не вирок крамниці — інв. B/§7.4.
                             Взаємовиключний із «Підтверджені»: разом дали б порожньо. -->
                        <Border Padding="10,4" StrokeShape="RoundRectangle 14" StrokeThickness="0.8"
                                Stroke="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}"
                                BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding OnlyPumped}" Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePumpedCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="⚠ Завищена стара ціна" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding OnlyPumped}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <HorizontalStackLayout Spacing="6"
                                               BindableLayout.ItemsSource="{Binding SortChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SortChip">
                                    <Border Padding="10,4" StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0.8"
                                            Stroke="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                                            BackgroundColor="Transparent">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor"
                                                        Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.PickSortCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}" FontSize="12">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
            <!-- «Ціни оновлено N хв тому» — чесна свіжість даних -->
            <Label Text="{Binding FreshnessText}" Style="{StaticResource Caption}"
                   FontSize="11" Margin="4,0"
                   IsVisible="{Binding FreshnessText, Converter={StaticResource NotEmpty}}" />
            <!-- дзвіночок: сповіщення про нові знижки в обраній категорії -->
            <HorizontalStackLayout Spacing="4" Margin="4,0" IsVisible="{Binding IsCategoryNarrowed}">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleWatchCategoryCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="🔔 Стежити за категорією" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                       IsVisible="{Binding IsCategoryWatched, Converter={StaticResource Invert}}" />
                <Label Text="🔔 Стежиш за категорією ✓ (тапни, щоб вимкнути)" FontSize="12"
                       Style="{StaticResource Caption}"
                       IsVisible="{Binding IsCategoryWatched}" />
            </HorizontalStackLayout>
            <!-- сусідні категорії розділу: стрибок «Ноутбуки → Процесори» одним тапом -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding HasNeighbors}">
                <HorizontalStackLayout Spacing="6" Padding="2,0"
                                       BindableLayout.ItemsSource="{Binding Neighbors}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <Border Style="{StaticResource Card}" Padding="10,4"
                                    StrokeShape="RoundRectangle 14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.PickCategoryCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Name}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
            <!-- у пошуку правила інші, ніж при гортанні — кажемо це прямо -->
            <Label Text="Пошук — по всьому каталогу, не лише знижки"
                   Style="{StaticResource Caption}" Margin="4,0"
                   IsVisible="{Binding IsSearching}" />
            <!-- і окремо: чому видача вийшла за межі обраної категорії -->
            <Label Text="{Binding SearchNote}" FontSize="12" Margin="4,0"
                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                   IsVisible="{Binding SearchNote, Converter={StaticResource NotEmpty}}" />
            <Label Text="{Binding ErrorMessage}" Margin="4,0"
                   TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />
        </VerticalStackLayout>

        <!-- стрічка -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                <CollectionView.EmptyView>
                    <!-- розумний порожній стан: дії замість глухого «нічого не знайдено»
                         (внутрішній VSL під ShowEmpty: EmptyView зʼявляється і під час
                         завантаження/помилки — кнопки там були б оманою) -->
                    <VerticalStackLayout Padding="32" Spacing="12" VerticalOptions="Center"
                                         IsVisible="{Binding ShowEmpty}">
                        <Label Text="Нічого не знайдено" HorizontalOptions="Center"
                               FontAttributes="Bold" />
                        <Button Text="Прибрати фільтр ціни" FontSize="13"
                                Command="{Binding ClearPriceFilterCommand}"
                                IsVisible="{Binding HasPriceFilter}" HorizontalOptions="Center" />
                        <Button Text="Шукати в усіх категоріях" FontSize="13"
                                Command="{Binding SearchAllCategoriesCommand}"
                                IsVisible="{Binding IsCategoryNarrowed}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Discount">
                        <Grid Padding="12,4">
                            <Border Style="{StaticResource Card}" Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.GoToDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="10">
                                    <!-- фото в рамці з фоном: биті/відсутні картинки не виглядають дірою -->
                                    <Border Grid.Column="0" Style="{StaticResource Thumb}"
                                            WidthRequest="72" HeightRequest="72" Padding="4"
                                            VerticalOptions="Start">
                                        <!-- фото декоративне: назву читає сусідній Label -->
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFit"
                                               AutomationProperties.IsInAccessibleTree="False" />
                                    </Border>
                                    <!-- дії картки: серденько (стежити) + чекбокс (порівняти) -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Start">
                                        <Label Text="{Binding HeartGlyph}" FontSize="22" Padding="6,0,2,0"
                                               HorizontalOptions="End"
                                               SemanticProperties.Description="Стежити за ціною"
                                               SemanticProperties.Hint="Додає або прибирає товар зі стеження"
                                               TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleWatchCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Text="{Binding CompareGlyph}" FontSize="20" Padding="6,0,2,0"
                                               HorizontalOptions="End"
                                               SemanticProperties.Description="Порівняти товар"
                                               SemanticProperties.Hint="Додає товар до порівняння"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleCompareCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding Title}" MaxLines="2" LineBreakMode="TailTruncation"
                                               Style="{StaticResource Body}" FontAttributes="Bold" />
                                        <!-- одна крамниця → її назва; група → «в N крамницях» без однієї назви -->
                                        <Label Text="{Binding SubTitle}" Style="{StaticResource Caption}"
                                               IsVisible="{Binding ShowStoreLine}" />
                                        <Label Text="{Binding StoresText}" Style="{StaticResource Caption}"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                                               IsVisible="{Binding HasMultiStores}" />
                                        <!-- Дата акції — нейтральним, а не червоним: червоне лишаємо ЛИШЕ
                                             пігулці −N%. Раніше на картці було дві червоні плями, і в
                                             стовпчику з п'яти карток око не мало за що зачепитись. -->
                                        <Label Text="{Binding PromoText}" Style="{StaticResource Caption}"
                                               FontSize="11" IsVisible="{Binding HasPromo}" />
                                        <!-- Ціна, стара ціна й −% — ОДНА думка, тож стоять поруч зліва.
                                             Раніше бейдж був притиснутий до правого краю (колонка «*»
                                             між ними), і око мусило стрибати через усю ширину картки,
                                             щоб зібрати «22 999 замість 42 999, це −47%». Порядок
                                             читання й ієрархія розмірів (18 → 12) роблять решту. -->
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="7"
                                              Margin="0,2,0,0">
                                            <Label Grid.Column="0" Text="{Binding PriceText}"
                                                   Style="{StaticResource PriceMain}" VerticalOptions="End" />
                                            <Label Grid.Column="1" Text="{Binding OldGrn}"
                                                   Style="{StaticResource PriceOld}"
                                                   VerticalOptions="End" IsVisible="{Binding HasOld}" />
                                            <Border Grid.Column="2" Style="{StaticResource PillDiscount}"
                                                    IsVisible="{Binding HasPct}" VerticalOptions="End">
                                                <Label Text="{Binding PctText}" TextColor="White"
                                                       FontAttributes="Bold" FontSize="11" />
                                            </Border>
                                        </Grid>
                                        <!-- «Дешевше в Rozetka на 6 887 ₴» — визнання, що НАША
                                             показана знижка не найкраща ціна. Незручно, але це
                                             буквально суть «Хапая». Зелена пігулка, а не сірий
                                             підпис: рядок рідкісний (~2% карток) і сірим губився б;
                                             колір інший, ніж у −% (червоний), щоб не зливалися. -->
                                        <Border IsVisible="{Binding HasCheaper}" Margin="0,4,0,0"
                                                HorizontalOptions="Start" Style="{StaticResource PillSave}">
                                            <Label Text="{Binding CheaperText}" FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource SaveFgLight}, Dark={StaticResource SaveFgDark}}" />
                                        </Border>
                                        <!-- Гучна знижка, яка не дає кращої ціни за ринок. Кажемо
                                             ФАКТ, не вирок: чужі ціни юридично не спростовують
                                             чиюсь стару ціну (статутний pumped — з історії, §5).
                                             Взаємовиключне з бейджем вище (сервер це гарантує). -->
                                        <Border IsVisible="{Binding HasSamePrice}" Margin="0,4,0,0"
                                                HorizontalOptions="Start" Style="{StaticResource PillWarn}">
                                            <Label Text="{Binding SamePriceText}" FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource WarnFgLight}, Dark={StaticResource WarnFgDark}}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       Margin="0,16" HorizontalOptions="Center" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- скелетон до першої відповіді: порожній екран «блимав» на кожній зміні
             фільтра (сприйнята швидкість — частина скарги на затримки) -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding ShowSkeleton}" Spacing="0"
                             BindableLayout.ItemsSource="{Binding SkeletonRows}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:Int32">
                    <Grid Padding="12,4">
                        <Border Style="{StaticResource Card}" Padding="10">
                            <Grid ColumnDefinitions="72,*" ColumnSpacing="10">
                                <BoxView Grid.Column="0" WidthRequest="72" HeightRequest="72"
                                         CornerRadius="10" Color="#1E888888" />
                                <VerticalStackLayout Grid.Column="1" Spacing="9" VerticalOptions="Center">
                                    <BoxView HeightRequest="13" CornerRadius="4" Color="#1E888888" />
                                    <BoxView HeightRequest="13" CornerRadius="4" Color="#14888888"
                                             WidthRequest="170" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="17" CornerRadius="4" Color="#1E888888"
                                             WidthRequest="110" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- плаваюча панель порівняння: зʼявляється коли обрано ≥2 товари (S14) -->
        <Border Grid.Row="1" IsVisible="{Binding CanCompare}" VerticalOptions="End"
                Margin="12" Padding="6,4,6,4" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                BackgroundColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                <Label Grid.Column="0" Text="✕" FontSize="18" TextColor="White" Padding="10,0"
                       VerticalOptions="Center" SemanticProperties.Description="Очистити порівняння">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearCompareCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Button Grid.Column="2" Text="{Binding CompareButtonText}" Command="{Binding OpenCompareCommand}"
                        FontAttributes="Bold" FontSize="14" BackgroundColor="Transparent"
                        TextColor="White" MinimumHeightRequest="44" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
