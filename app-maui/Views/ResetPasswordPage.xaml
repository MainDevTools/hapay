<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:conv="clr-namespace:Hapay.Converters"
    x:DataType="vm:ResetPasswordViewModel"
    Title="Скидання пароля">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
        <conv:InvertBoolConverter x:Key="Invert" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center" MaximumWidthRequest="480">

            <Label Text="Забув пароль?" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Введи email — надішлемо код для зміни пароля."
                   FontSize="14" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email"
                   IsEnabled="{Binding CodeSent, Converter={StaticResource Invert}}" />

            <!-- етап 1: надіслати код -->
            <Button Text="Надіслати код" Command="{Binding RequestCodeCommand}"
                    IsVisible="{Binding CodeSent, Converter={StaticResource Invert}}"
                    MinimumHeightRequest="48" />

            <Label Text="{Binding Info}" FontSize="13"
                   IsVisible="{Binding Info, Converter={StaticResource NotEmpty}}"
                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />

            <!-- етап 2: код + новий пароль (після запиту) -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding CodeSent}">
                <Entry Placeholder="Код із листа (6 цифр)" Text="{Binding Code}"
                       Keyboard="Numeric" MaxLength="6" />
                <Entry Placeholder="Новий пароль (≥ 8 символів)" Text="{Binding NewPassword}"
                       IsPassword="True" ReturnType="Done"
                       ReturnCommand="{Binding ConfirmCommand}" />
                <Button Text="Змінити пароль" Command="{Binding ConfirmCommand}"
                        MinimumHeightRequest="48" />
            </VerticalStackLayout>

            <Label Text="{Binding Error}" TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}"
                   IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
