<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.CatalogPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:models="clr-namespace:Hapay.Models"
    xmlns:conv="clr-namespace:Hapay.Converters"
    x:DataType="vm:CatalogViewModel"
    Title="Хапай">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
    </ContentPage.Resources>

    <!-- Дії тулбара — іконками (Material: у top app bar дії саме значки, текст там
         нестандартний). Text лишаємо: Android бере його для overflow-меню й для
         підказки на довгий тап, тож доступність не втрачається. -->
    <!-- «Стеження» пішло в таб-бар (UX-пакет 2026-07-24) — тулбар без дублів -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Акаунт" Command="{Binding AccountCommand}"
                     IconImageSource="{AppThemeBinding Light=ic_account_light.png, Dark=ic_account_dark.png}" />
    </ContentPage.ToolbarItems>

    <!-- Головна БЕЗ повної сітки 171 плитки (UX-пакет 2026-07-24): сітка дублювала
         «Каталог товарів» і робила сторінку кілометровою стіною. Лишається вітрина:
         пошук → банери → Популярні моделі → Популярні розділи → «Весь каталог». -->
    <Grid RowDefinitions="Auto,*" Padding="0">

        <VerticalStackLayout Grid.Row="0" Padding="12,8" Spacing="8">
            <!-- фейк-поле: тап відкриває повний екран пошуку (SearchPage) — там живі
                 результати, збіги категорій і історія запитів (2026-07-25) -->
            <Border Style="{StaticResource FilterBar}" Padding="14,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8"
                                       SemanticProperties.Description="Пошук по каталогу"
                                       SemanticProperties.Hint="Відкриває екран пошуку">
                    <Label Text="🔍" FontSize="14" VerticalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <Label Text="Пошук за назвою…" FontSize="14"
                           Style="{StaticResource Caption}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <!-- Два входи, яких у застосунку не було (S28): виміряні зниження — наше
                 єдине непідробне твердження, а крамниці до цього жили лише на сайті. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDropsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="📉 Що подешевшало" FontAttributes="Bold" FontSize="14" />
                        <Label Text="за нашими вимірами" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenStoresCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="🏪 Крамниці" FontAttributes="Bold" FontSize="14" />
                        <Label Text="за ким стежимо" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="{Binding ErrorMessage}" Margin="4,0"
                   TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="0,4,0,24" Spacing="8">

                    <!-- банерна карусель: топ-категорії з фото, сторінки по 4 плитки;
                         PeekAreaInsets показує край наступної сторінки — натяк на свайп -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasBanners}">
                        <CarouselView ItemsSource="{Binding BannerPages}" HeightRequest="300"
                                      Loop="False" IndicatorView="BannerDots"
                                      PeekAreaInsets="0,0,24,0">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BannerPage">
                                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween"
                                                AlignContent="SpaceBetween" Padding="12,2,4,2"
                                                BindableLayout.ItemsSource="{Binding .}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BannerTile">
                                                <Border StrokeThickness="0" BackgroundColor="{Binding Bg}"
                                                        StrokeShape="RoundRectangle 18"
                                                        FlexLayout.Basis="49%" HeightRequest="150">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCategoryCommand}"
                                                            CommandParameter="{Binding Cat}" />
                                                    </Border.GestureRecognizers>
                                                    <!-- текст ЛІВОРУЧ, фото у власній БІЛІЙ заокругленій
                                                         картці праворуч: фото з білим фоном (ТВ/пилосос —
                                                         JPG) зливаються з нею, прозорі PNG (смартфон/
                                                         холодильник) сідають чисто — жодних білих наліпок
                                                         на пастелі, вигляд уніфікований (як «Популярні
                                                         розділи»). Впіймано прогоном 2026-07-25. -->
                                                    <Grid ColumnDefinitions="1.6*,1*" Padding="12,10,8,10"
                                                          ColumnSpacing="5">
                                                        <!-- Ширша текстова колонка + шрифт 12: односкладові
                                                             довгі назви («Кондиціонери», «Холодильники»)
                                                             WordWrap НЕ переносить (нема пробілу), тож мусять
                                                             уміститись у рядок. HorizontalOptions=Fill —
                                                             інакше Label бере мінімальну ширину й ріже
                                                             (регресія v5). Лічильник прибрано (вітрина). -->
                                                        <!-- Label ПРЯМО в комірці Grid (не в StackLayout):
                                                             StackLayout вимірює дітей нескінченною шириною →
                                                             WordWrap «думає», що все в рядок, і Grid ріже
                                                             горизонтально. Комірка Grid дає обмежену ширину →
                                                             перенос працює (прогін 2026-07-25, 8 ітерацій). -->
                                                        <Label Grid.Column="0" Text="{Binding Cat.Name}"
                                                               TextColor="{Binding Fg}" FontSize="12"
                                                               FontAttributes="Bold" LineBreakMode="WordWrap"
                                                               HorizontalOptions="Fill" VerticalOptions="Center" />
                                                        <Border Grid.Column="1" BackgroundColor="#FFFFFF"
                                                                StrokeThickness="0" Padding="5" Margin="0,2"
                                                                VerticalOptions="Fill"
                                                                StrokeShape="RoundRectangle 12">
                                                            <Image Source="{Binding Cat.ImageUrl}"
                                                                   Aspect="AspectFit"
                                                                   AutomationProperties.IsInAccessibleTree="False" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>
                        <IndicatorView x:Name="BannerDots" HorizontalOptions="Center"
                                       IndicatorSize="7" IndicatorColor="#66888888"
                                       SelectedIndicatorColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                    </VerticalStackLayout>

                    <!-- «Нещодавно переглянуті» — локальна історія, повернення до порівняння -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasRecent}">
                        <Label Text="Нещодавно переглянуті" Style="{StaticResource H2}"
                               Padding="16,8,16,0" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Padding="16,0" Spacing="10"
                                                   BindableLayout.ItemsSource="{Binding Recent}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Discount">
                                        <Border WidthRequest="128" Style="{StaticResource Card}" Padding="8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenProductCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="6">
                                                <Border HeightRequest="72" Padding="6"
                                                        Style="{StaticResource Thumb}">
                                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFit" />
                                                </Border>
                                                <Label Text="{Binding Title}" Style="{StaticResource Caption}"
                                                       FontSize="11" MaxLines="2" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding CurrentGrn}" FontAttributes="Bold" FontSize="12" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- «Популярні моделі»: товар у найбільшій к-сті крамниць → «від X ₴» -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPopular}">
                        <Label Text="Популярні моделі" Style="{StaticResource H2}"
                               Padding="16,8,16,0" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Padding="16,0" Spacing="10"
                                                   BindableLayout.ItemsSource="{Binding Popular}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Discount">
                                        <Border WidthRequest="140" Style="{StaticResource Card}" Padding="10">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenProductCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="8">
                                                <Border HeightRequest="86" Padding="8"
                                                        Style="{StaticResource Thumb}">
                                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFit" />
                                                </Border>
                                                <Label Text="{Binding Title}" Style="{StaticResource Caption}"
                                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding PriceText}" FontAttributes="Bold" FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- «Популярні розділи»: картки з фото + лінки топ-категорій -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPopularSections}">
                        <Label Text="Популярні розділи" Style="{StaticResource H2}"
                               Padding="16,10,16,0" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Padding="16,0" Spacing="10"
                                                   BindableLayout.ItemsSource="{Binding PopularSections}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SectionCard">
                                        <Border WidthRequest="256" Style="{StaticResource Card}"
                                                Padding="0" StrokeShape="RoundRectangle 18">
                                            <VerticalStackLayout>
                                                <Border HeightRequest="118" Padding="12" Margin="12,12,12,0"
                                                        Style="{StaticResource Thumb}"
                                                        StrokeShape="RoundRectangle 12"
                                                        IsVisible="{Binding HasImage}">
                                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFit" />
                                                </Border>
                                                <VerticalStackLayout Padding="14,10,14,12" Spacing="7">
                                                    <Label Text="{Binding Title}" FontAttributes="Bold"
                                                           FontSize="15" />
                                                    <FlexLayout Wrap="Wrap" JustifyContent="Start"
                                                                BindableLayout.ItemsSource="{Binding Cats}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:Category">
                                                                <Label Text="{Binding Name}" FontSize="12.5"
                                                                       Margin="0,0,14,7"
                                                                       TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCategoryCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- вхід у повний каталог (171 категорія живе там, не на головній) -->
                    <Border Style="{StaticResource Card}" Margin="16,10" Padding="14,12"
                            StrokeShape="RoundRectangle 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAllCatalogCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Весь каталог" FontAttributes="Bold" FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                            <Label Grid.Column="1" Text="→" FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                        </Grid>
                    </Border>

                    <Label Text="Поки немає знижок" HorizontalOptions="Center" Padding="0,24"
                           FontAttributes="Bold" IsVisible="{Binding ShowEmpty}" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
