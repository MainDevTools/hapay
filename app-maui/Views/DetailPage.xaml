<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:Hapay.Controls"
    x:Name="ThisPage"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:models="clr-namespace:Hapay.Models"
    xmlns:conv="clr-namespace:Hapay.Converters"
    x:DataType="vm:DetailViewModel"
    Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
        <conv:InvertBoolConverter x:Key="Invert" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Фото на власній білій поверхні, а не «в повітрі»: у стрічці й каталозі
                 воно теж на білому, тож перехід у картку не міняє вигляд товару. -->
            <Border Style="{StaticResource Thumb}" Padding="12" HeightRequest="220">
                <Image Source="{Binding Item.ImageUrl}" Aspect="AspectFit" />
            </Border>

            <Label Text="{Binding Item.Title}" Style="{StaticResource H1}" FontSize="{StaticResource F4}" />
            <Label Text="{Binding Item.VariantNote}" Style="{StaticResource Caption}"
                   IsVisible="{Binding Item.VariantNote, Converter={StaticResource NotEmpty}}" />

            <!-- ціна: ДІАПАЗОН по крамницях згори (§17) — «5 999 – 6 499 ₴» або одна ціна -->
            <Label Text="{Binding PriceRangeText}" Style="{StaticResource H1}" FontSize="{StaticResource F6}" />

            <!-- «Наявно в N крамницях» одразу під ціною; деталі — блок «Де купити» нижче -->
            <Label Text="{Binding OffersLine}" FontAttributes="Bold" FontSize="{StaticResource F2}"
                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                   IsVisible="{Binding HasOffers}" />

            <!-- одна крамниця зі знижкою → класичне «стара ціна + −%» (для діапазону зайве) -->
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding ShowSingleDiscount}">
                <Label Text="{Binding Item.OldGrn}" Style="{StaticResource PriceOld}"
                       FontSize="{StaticResource F3}" VerticalOptions="Center" />
                <Border Style="{StaticResource PillDiscount}" Padding="6,2" VerticalOptions="Center">
                    <Label Text="{Binding Item.PctText}" TextColor="White" FontAttributes="Bold" FontSize="{StaticResource F1}" />
                </Border>
            </HorizontalStackLayout>

            <!-- «Знижка нічого не дає» — на картці особливо доречно: одразу під нею блок
                 «Де купити» показує ті самі крамниці з тією самою ціною, тож людина
                 бачить не наше твердження, а докази. -->
            <Border IsVisible="{Binding Item.HasSamePrice}" HorizontalOptions="Start"
                    Style="{StaticResource PillWarn}" Padding="8,6">
                <Label Text="{Binding Item.SamePriceText}" FontSize="{StaticResource F2}" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource WarnFgLight}, Dark={StaticResource WarnFgDark}}" />
            </Border>

            <!-- «Зараз найнижча ціна за 30 днів/з dd.MM» — Omnibus-відповідь на питання
                 «купувати зараз чи чекати»; зелена пігулка лише коли це ФАКТ з історії -->
            <Border IsVisible="{Binding IsAtMin30}" HorizontalOptions="Start"
                    Style="{StaticResource PillSave}" Padding="8,6">
                <Label Text="{Binding Min30Badge}" FontSize="{StaticResource F2}" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource SaveFgLight}, Dark={StaticResource SaveFgDark}}" />
            </Border>

            <!-- скелетон на місці 🏆/«Де купити», поки офери в дорозі: блоки
                 «вистрибували» зі зсувом усього лейауту -->
            <Border IsVisible="{Binding LoadingOffers}" Style="{StaticResource Card}"
                    Padding="12,12" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <ctl:SkeletonBar HeightRequest="16" CornerRadius="8" Color="{AppThemeBinding Light={StaticResource SkeletonLight}, Dark={StaticResource SkeletonDark}}"
                             WidthRequest="200" HorizontalOptions="Start" />
                    <ctl:SkeletonBar HeightRequest="13" CornerRadius="8" Color="{AppThemeBinding Light={StaticResource SkeletonSoftLight}, Dark={StaticResource SkeletonSoftDark}}" />
                    <ctl:SkeletonBar HeightRequest="13" CornerRadius="8" Color="{AppThemeBinding Light={StaticResource SkeletonSoftLight}, Dark={StaticResource SkeletonSoftDark}}"
                             WidthRequest="220" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- 🏆 «Наш вибір» (S9): найвигідніший спосіб купити — не найдешевша цифра.
                 Tap розкриває кандидатів у ЛЮДСЬКИХ одиницях (редизайн 2026-07-24:
                 сирі частки формули з рядків прибрано — прозорість живе в
                 «Як ми рахуємо?» і в API). Бейдж перевірки знижок — фактологічний,
                 лише на краях і лише при достатніх даних. -->
            <Border IsVisible="{Binding HasChoice}" Style="{StaticResource Card}"
                    Padding="12,12" StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleChoiceCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ChoiceLine}" FontAttributes="Bold" FontSize="{StaticResource F4}"
                           TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                    <Label Text="{Binding ChoiceSavingsText}" FontSize="{StaticResource F2}"
                           IsVisible="{Binding ShowSavings}" Style="{StaticResource Body}" />
                    <!-- головна CTA: одна велика кнопка переможця (ціна — цінникова) -->
                    <Button Text="{Binding BuyCtaText}" Command="{Binding BuyBestCommand}"
                            IsVisible="{Binding ShowBuyCta}" FontAttributes="Bold" FontSize="{StaticResource F3}"
                            CornerRadius="12" Margin="0,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                            TextColor="White" />
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsChoiceExpanded}"
                                         BindableLayout.ItemsSource="{Binding Choice.Candidates}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ChoiceCandidate">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="0">
                                        <Label Text="{Binding Store}" FontSize="{StaticResource F2}" FontAttributes="Bold" />
                                        <Label Text="{Binding DetailText}" Style="{StaticResource Caption}" FontSize="{StaticResource F1}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding EffGrn}" FontSize="{StaticResource F2}"
                                           FontAttributes="Bold" HorizontalOptions="End"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <!-- формула з ЖИВИМИ вагами з сервера — для тих, кому треба -->
                    <Label Text="Як ми рахуємо? ▸" FontSize="{StaticResource F1}" FontAttributes="Bold"
                           IsVisible="{Binding IsChoiceExpanded}"
                           TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFormulaCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding Choice.FormulaText}" Style="{StaticResource Caption}"
                           FontSize="{StaticResource F1}" IsVisible="{Binding IsFormulaExpanded}" />
                    <!-- TODO(§8.2 брифа S9): фінальний текст дисклеймера — оператор -->
                    <Label Text="Розрахунок за відкритою формулою з публічних цін. Крамниці не платять за позицію."
                           Style="{StaticResource Caption}" FontSize="{StaticResource F1}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Історія ціни" Style="{StaticResource H2}" Margin="0,12,0,0" />
            <ActivityIndicator IsRunning="{Binding LoadingHistory}" IsVisible="{Binding LoadingHistory}"
                               HorizontalOptions="Start" />
            <Label Text="{Binding HistoryNote}" Style="{StaticResource Caption}"
                   IsVisible="{Binding HistoryNote, Converter={StaticResource NotEmpty}}" />
            <!-- підпис обраної точки (тап/драг по графіку) -->
            <Label x:Name="ChartTip" FontSize="{StaticResource F2}" FontAttributes="Bold" IsVisible="False"
                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
            <GraphicsView x:Name="Chart" HeightRequest="180" IsVisible="{Binding HasChart}"
                          SemanticProperties.Description="Графік історії ціни"
                          SemanticProperties.Hint="Торкніться, щоб побачити ціну на дату"
                          StartInteraction="OnChartTouch" DragInteraction="OnChartTouch" />
            <!-- статутний мінімум (Omnibus) людською мовою; чесний до глибини історії -->
            <Label Text="{Binding Min30Text}" FontSize="{StaticResource F2}" FontAttributes="Bold"
                   IsVisible="{Binding Min30Text, Converter={StaticResource NotEmpty}}" />
            <!-- прозорість детекції: що означають наші позначки -->
            <Label Text="ⓘ Як ми перевіряємо знижки" FontSize="{StaticResource F1}"
                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExplainBadgesCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <!-- Канонічна модель: та сама річ в інших крамницях. Показуємо лише коли
                 модель справді є (артикул звірено) — інакше це посилання в нікуди. -->
            <Label Text="⇄ Ця сама модель в інших крамницях" FontSize="{StaticResource F1}"
                   IsVisible="{Binding HasModel}"
                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenModelCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- «Де купити» (T15/§17.5): той самий товар (mpn) у крамницях, від найдешевшої.
                 Видно лише коли є ≥2 крамниці — інакше блок не додає нічого. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasOffers}" Margin="0,12,0,0">
                <Label Text="Де купити" Style="{StaticResource H2}" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Offers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Offer">
                            <Border Style="{StaticResource Card}" Padding="12,12"
                                    StrokeShape="RoundRectangle 12"
                                    Opacity="{Binding Opacity}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenOfferCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <!-- 🏆 у переможця «Нашого вибору»; «чесність N%» — з наших discount_event -->
                                        <Label Text="{Binding StoreLine}" Style="{StaticResource Body}"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding HonestyNote}" Style="{StaticResource Caption}"
                                               FontSize="{StaticResource F1}"
                                               IsVisible="{Binding HonestyNote, Converter={StaticResource NotEmpty}}" />
                                        <!-- Уцінене не ховаємо, але й не даємо прочитати його
                                             як «найкращу ціну»: без позначки найдешевший рядок
                                             виглядає звичайною пропозицією. -->
                                        <Border IsVisible="{Binding IsUsed}" HorizontalOptions="Start"
                                                Style="{StaticResource PillWarn}" Padding="6,2">
                                            <Label Text="{Binding UsedLabel}" FontSize="{StaticResource F1}" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource WarnFgLight}, Dark={StaticResource WarnFgDark}}" />
                                        </Border>
                                        <Label Text="Немає в наявності" Style="{StaticResource Caption}"
                                               FontSize="{StaticResource F1}"
                                               IsVisible="{Binding InStock, Converter={StaticResource Invert}}" />
                                    </VerticalStackLayout>
                                    <!-- ціна крамниці як згори картки: поточна + −% в рядок, стара перекреслена під ними -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                            <Label Text="{Binding CurrentGrn}" Style="{StaticResource PriceMain}"
                                                   FontSize="{StaticResource F4}" VerticalOptions="Center" />
                                            <Border Style="{StaticResource PillDiscount}" Padding="4,2"
                                                    StrokeShape="RoundRectangle 8" VerticalOptions="Center"
                                                    IsVisible="{Binding HasPct}">
                                                <Label Text="{Binding PctText}" TextColor="White"
                                                       FontAttributes="Bold" FontSize="{StaticResource F1}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding OldGrn}" Style="{StaticResource PriceOld}"
                                               HorizontalOptions="End" IsVisible="{Binding HasOld}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Характеристики (S12): пари назва-значення зі спец-таблиці картки ОДНІЄЇ
                 крамниці групи. Провенанс видимий завжди (інваріант B5: факти з
                 джерелом, не наш текст). Згорнуто — перші 6 рядків. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasSpecs}" Margin="0,12,0,0">
                <Label Text="Характеристики" Style="{StaticResource H2}" />
                <Border Style="{StaticResource Card}" Padding="12,12" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="6">
                        <VerticalStackLayout Spacing="4"
                                             BindableLayout.ItemsSource="{Binding VisibleSpecs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SpecAttr">
                                    <Grid ColumnDefinitions="5*,6*" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding Name}"
                                               Style="{StaticResource Caption}" FontSize="{StaticResource F1}" />
                                        <Label Grid.Column="1" Text="{Binding Value}"
                                               Style="{StaticResource Body}" FontSize="{StaticResource F1}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding SpecsToggleText}" FontSize="{StaticResource F2}" FontAttributes="Bold"
                               IsVisible="{Binding ShowSpecsToggle}"
                               TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleSpecsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="{Binding SpecsProvenance}" Style="{StaticResource Caption}"
                               FontSize="{StaticResource F1}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Button Text="Відкрити в крамниці" Command="{Binding OpenStoreCommand}"
                    Margin="0,12,0,0" MinimumHeightRequest="48" />

            <!-- «Стежити за ціною»: доступно лише залогіненим (список належить акаунту) -->
            <!-- Цільова ціна (S29): порожньо = будь-яке зниження, тобто стара поведінка.
                 Нікого не змушуємо називати число, але тому, хто хоче, більше не
                 доводиться відсіювати «подешевшало на 40 грн» вручну. -->
            <Entry Placeholder="Сповістити, коли ціна впаде до (₴)" Keyboard="Numeric"
                   Text="{Binding TargetText}" IsVisible="{Binding CanWatch}" />
            <Label Text="{Binding Low.Text}" Style="{StaticResource Caption}"
                   IsVisible="{Binding HasLow}" />
            <Button Text="{Binding WatchButtonText}" Command="{Binding WatchCommand}"
                    IsEnabled="{Binding WatchBusy, Converter={StaticResource Invert}}"
                    IsVisible="{Binding CanWatch}" MinimumHeightRequest="48"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                    BorderColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                    BorderWidth="1" />
            <!-- «Поділитись» — системний share sheet (назва + ціна + лінк) -->
            <Button Text="Поділитись" Command="{Binding ShareProductCommand}"
                    MinimumHeightRequest="44" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                    BorderColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                    BorderWidth="1" />
            <Label Text="{Binding WatchNote}" FontSize="{StaticResource F2}" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                   IsVisible="{Binding WatchNote, Converter={StaticResource NotEmpty}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
