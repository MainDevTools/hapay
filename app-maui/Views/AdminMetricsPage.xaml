<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.AdminMetricsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:models="clr-namespace:Hapay.Models"
    xmlns:conv="clr-namespace:Hapay.Converters"
    x:DataType="vm:AdminMetricsViewModel"
    Title="Метрики">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="12">

                <Label Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}"
                       TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}" />

                <!-- дані: скільки зібрано і як швидко росте -->
                <Border Style="{StaticResource Card}" Padding="12" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Дані" FontAttributes="Bold" FontSize="{StaticResource F3}" Margin="0,0,0,4" />
                        <Label Text="{Binding Metrics.Data.ProductsText}" Style="{StaticResource Body}" />
                        <Label Text="{Binding Metrics.Data.SnapshotsText}" Style="{StaticResource Body}" />
                        <Label Text="{Binding Metrics.Data.EventsText}" Style="{StaticResource Body}" />
                        <Label Text="{Binding Metrics.Data.ScopeText}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- детекція: власне продукт. Нульові стани НЕ ховаємо -->
                <Border Style="{StaticResource Card}" Padding="12" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Перевірка знижок" FontAttributes="Bold" FontSize="{StaticResource F3}"
                               Margin="0,0,0,4" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Badges}" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:BadgeRow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Label}" Style="{StaticResource Body}" />
                                        <Label Grid.Column="1" Text="{Binding CountText}"
                                               Style="{StaticResource Caption}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- збір: мовчазні крамниці згори (саме вони потребують дії) -->
                <Border Style="{StaticResource Card}" Padding="12" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Збір" FontAttributes="Bold" FontSize="{StaticResource F3}" />
                        <Label Text="{Binding Metrics.Collect.HealthText}" Style="{StaticResource Caption}"
                               Margin="0,0,0,6" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stores}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:StoreRow">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding Source}" Style="{StaticResource Body}" />
                                        <Label Text="{Binding DetailText}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="12" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Акаунти" FontAttributes="Bold" FontSize="{StaticResource F3}" Margin="0,0,0,4" />
                        <Label Text="{Binding Metrics.Accounts.TotalsText}" Style="{StaticResource Body}" />
                        <Label Text="{Binding Metrics.Accounts.RolesText}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding Metrics.Accounts.ActivityText}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
