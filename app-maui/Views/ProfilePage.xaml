<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:conv="clr-namespace:Hapay.Converters"
    x:DataType="vm:ProfileViewModel"
    Title="Профіль">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
        <conv:InvertBoolConverter x:Key="Invert" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Start">

        <Label Text="{Binding Email}" FontSize="{StaticResource F4}" FontAttributes="Bold" />
        <Label Text="{Binding RoleLabel}" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

        <!-- банер «email не підтверджено» (S13): бурштиновий, з діями підтвердити/повторити -->
        <Border IsVisible="{Binding ShowVerifyBanner}" Style="{StaticResource PillWarn}"
                Padding="12,8" StrokeShape="RoundRectangle 8">
            <VerticalStackLayout Spacing="8">
                <Label Text="Email не підтверджено" FontAttributes="Bold" FontSize="{StaticResource F3}"
                       TextColor="{AppThemeBinding Light={StaticResource WarnFgLight}, Dark={StaticResource WarnFgDark}}" />
                <Label Text="Підтверди email кодом із листа, щоб убезпечити акаунт і повернути доступ, якщо забудеш пароль."
                       FontSize="{StaticResource F1}"
                       TextColor="{AppThemeBinding Light={StaticResource WarnFgLight}, Dark={StaticResource WarnFgDark}}" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Ввести код" Command="{Binding VerifyEmailCommand}"
                            FontSize="{StaticResource F2}" MinimumHeightRequest="40" />
                    <Button Text="Надіслати код" Command="{Binding ResendVerifyCommand}"
                            FontSize="{StaticResource F2}" MinimumHeightRequest="40" BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource WarnFgLight}, Dark={StaticResource WarnFgDark}}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
        <Label Text="{Binding VerifyStatus}" FontSize="{StaticResource F2}"
               IsVisible="{Binding VerifyStatus, Converter={StaticResource NotEmpty}}"
               TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />

        <!-- збір: лише для колектора. Тягне HTML крамниць зі свого IP, парсить сервер (S11 етап 3) -->
        <VerticalStackLayout IsVisible="{Binding IsCollector}" Spacing="8">
            <Border Padding="12" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#EEF6EC, Dark=#132A1D}"
                    StrokeShape="RoundRectangle 8">
                <Label Text="Ти колектор — збираєш ціни зі своєї мережі. Тисни, коли є Wi-Fi."
                       FontSize="{StaticResource F2}" />
            </Border>
            <!-- фоновий збір (T16): WorkManager кожні ~15 хв, лише Wi-Fi + зарядка -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AutoCollectSupported}">
                <Label Text="Збирати автоматично (Wi-Fi + зарядка)"
                       VerticalOptions="Center" FontSize="{StaticResource F3}" />
                <Switch Grid.Column="1" IsToggled="{Binding AutoCollect}" />
            </Grid>
            <Label Text="{Binding TodayText}" FontSize="{StaticResource F1}" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

            <!-- Стан збору З СЕРВЕРА. Рядок вище рахує лише цей пристрій і мовчить
                 однаково і при справному зборі, і при мертвому — саме через це
                 двогодинна зупинка 2026-07-21 лишалась непоміченою. Коли збір
                 мовчить довше за поріг, рядок стає бурштиновою пігулкою. -->
            <!-- справний збір — зелена пігулка (той самий колір, що «вигода» в стрічці) -->
            <Border Style="{StaticResource PillSave}" Padding="8,6" HorizontalOptions="Fill"
                    IsVisible="{Binding ShowHealthOk}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding HealthNote}" FontSize="{StaticResource F2}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource SaveFgLight}, Dark={StaticResource SaveFgDark}}" />
                    <Label Text="{Binding HealthDetail}" FontSize="{StaticResource F1}"
                           TextColor="{AppThemeBinding Light={StaticResource SaveFgLight}, Dark={StaticResource SaveFgDark}}" />
                </VerticalStackLayout>
            </Border>
            <!-- мовчить довше за поріг — бурштинова, як і решта «щось не так» -->
            <Border Style="{StaticResource PillWarn}" Padding="8,6" HorizontalOptions="Fill"
                    IsVisible="{Binding ShowHealthWarn}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding HealthNote}" FontSize="{StaticResource F2}" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource WarnFgLight}, Dark={StaticResource WarnFgDark}}" />
                    <Label Text="{Binding HealthDetail}" FontSize="{StaticResource F1}"
                           TextColor="{AppThemeBinding Light={StaticResource WarnFgLight}, Dark={StaticResource WarnFgDark}}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Зібрати ціни зараз" Command="{Binding CollectCommand}" MinimumHeightRequest="48" />
            <ActivityIndicator IsRunning="{Binding IsCollecting}" IsVisible="{Binding IsCollecting}"
                               HorizontalOptions="Center" />
            <Label Text="{Binding CollectStatus}" FontSize="{StaticResource F2}" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                   IsVisible="{Binding CollectStatus, Converter={StaticResource NotEmpty}}" />
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" Margin="0,8" />

        <Button Text="Мої відстеження" Command="{Binding WatchlistCommand}"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                BorderColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                BorderWidth="1" MinimumHeightRequest="48" />

        <!-- адмін-панель (S15): лише moderator+; сервер гейтить незалежно від UI -->
        <Button Text="Адмін-панель" Command="{Binding AdminCommand}"
                IsVisible="{Binding IsModerator}"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                BorderColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                BorderWidth="1" MinimumHeightRequest="48" />

        <!-- та сама перевірка, що й фонова, але зараз — не чекати годину -->
        <Button Text="Перевірити зниження цін" Command="{Binding CheckDropsCommand}"
                IsEnabled="{Binding CheckingDrops, Converter={StaticResource Invert}}"
                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" MinimumHeightRequest="44" />
        <Label Text="{Binding DropsStatus}" FontSize="{StaticResource F2}" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
               HorizontalOptions="Center"
               IsVisible="{Binding DropsStatus, Converter={StaticResource NotEmpty}}" />

        <!-- тема застосунку: системна / світла / темна (Preferences, живе між запусками) -->
        <VerticalStackLayout Spacing="4">
            <Label Text="Тема" FontSize="{StaticResource F2}" FontAttributes="Bold" />
            <Picker x:Name="ThemePicker" FontSize="{StaticResource F2}"
                    SelectedIndexChanged="OnThemeChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Системна</x:String>
                        <x:String>Світла</x:String>
                        <x:String>Темна</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </VerticalStackLayout>

        <Button Text="Вийти" Command="{Binding LogoutCommand}"
                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}" MinimumHeightRequest="48" />

        <!-- Видалення акаунта — вимога Google Play (шлях у застосунку + веб-адреса).
             Дрібним і без заливки: дія незворотна, і вона не має конкурувати оком
             із «Вийти», яку тиснуть щодня. -->
        <Label Text="Видалити акаунт" FontSize="{StaticResource F1}" HorizontalOptions="Center" Margin="0,4,0,0"
               TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
            </Label.GestureRecognizers>
        </Label>

        <!-- юр-посилання (обов'язкові для App Store / Google Play) -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,20,0,0">
            <Label Text="Конфіденційність" FontSize="{StaticResource F1}" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenLinkCommand}"
                                          CommandParameter="https://hapay.today/privacy" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Умови" FontSize="{StaticResource F1}" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenLinkCommand}"
                                          CommandParameter="https://hapay.today/terms" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Підтримка" FontSize="{StaticResource F1}" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenLinkCommand}"
                                          CommandParameter="https://hapay.today/support" />
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
