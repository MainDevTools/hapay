<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.CategoryPickerPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:models="clr-namespace:Hapay.Models"
    xmlns:conv="clr-namespace:Hapay.Converters"
    x:DataType="vm:CategoryPickerViewModel"
    Title="Каталог товарів">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="0">

        <Border Grid.Row="0" Style="{StaticResource FilterBar}" Margin="12,8">
            <SearchBar Placeholder="Пошук розділу…" Text="{Binding SearchText}" />
        </Border>

        <!-- рівень 2: шапка розділу з поверненням (E-Katalog: «< Мобільні та зв'язок») -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Padding="16,4"
              IsVisible="{Binding ShowCurrent}"
              SemanticProperties.Description="Назад до розділів">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding BackToSectionsCommand}" />
            </Grid.GestureRecognizers>
            <Label Grid.Column="0" Text="‹" FontSize="20" FontAttributes="Bold" Padding="0,0,10,0"
                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
            <Label Grid.Column="1" Text="{Binding SectionTitle}" FontSize="15" FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        </Grid>

        <Label Grid.Row="1" Text="{Binding ErrorMessage}" Margin="16,4"
               TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="0,0,0,24">

                <!-- рівень 1: розділи рядками на всю ширину -->
                <VerticalStackLayout IsVisible="{Binding ShowSections}"
                                     BindableLayout.ItemsSource="{Binding Sections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryGroup">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenSectionCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" Text="{Binding Icon}" FontSize="18"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                           TextTransform="Uppercase" FontAttributes="Bold"
                                           VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2" Text="›" FontSize="18"
                                           Style="{StaticResource Caption}" VerticalOptions="Center" />
                                </Grid>
                                <BoxView HeightRequest="0.6" Color="#33888888" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- рівень 2: категорії відкритого розділу -->
                <VerticalStackLayout IsVisible="{Binding ShowCurrent}"
                                     BindableLayout.ItemsSource="{Binding Current}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" Padding="16,14" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.PickCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                           TextTransform="Uppercase" VerticalOptions="Center"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding CountText}"
                                           Style="{StaticResource Caption}" FontSize="11"
                                           VerticalOptions="Center" />
                                </Grid>
                                <BoxView HeightRequest="0.6" Color="#33888888" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- пошук: плоскі збіги з усього каталогу (краще за E-Katalog: одразу категорії) -->
                <VerticalStackLayout IsVisible="{Binding ShowFound}"
                                     BindableLayout.ItemsSource="{Binding Found}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.PickCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0" Text="{Binding Icon}" FontSize="16"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="13" TextTransform="Uppercase"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Section}" Style="{StaticResource Caption}"
                                               FontSize="11" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding CountText}"
                                           Style="{StaticResource Caption}" FontSize="11"
                                           VerticalOptions="Center" />
                                </Grid>
                                <BoxView HeightRequest="0.6" Color="#33888888" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- «Усі категорії» — внизу рівня розділів -->
                <Grid ColumnDefinitions="*" Padding="16,14" IsVisible="{Binding ShowSections}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickAllCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="УСІ КАТЕГОРІЇ" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
