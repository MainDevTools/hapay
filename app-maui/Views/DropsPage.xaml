<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.DropsPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:Hapay.Controls"
    xmlns:beh="clr-namespace:Hapay.Behaviors"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:models="clr-namespace:Hapay.Models"
    xmlns:conv="clr-namespace:Hapay.Converters"
    x:DataType="vm:DropsViewModel"
    Title="Що подешевшало">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="12,8" Spacing="8">
            <Label Text="Це не оголошення крамниць, а різниця між двома нашими вимірами. Знижку можна намалювати — зниження ціни ми бачимо самі."
                   Style="{StaticResource Caption}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Picker Grid.Column="0" ItemsSource="{Binding Windows}"
                        SelectedIndex="{Binding WindowIndex}" Title="Проміжок" />
                <Picker Grid.Column="1" ItemsSource="{Binding Orders}"
                        SelectedIndex="{Binding OrderIndex}" Title="Порядок" />
            </Grid>

            <!-- Застереження постійне, а не лише в режимі «найбільші»: ми бачимо ціну
                 на сторінці, а не пакування, і різкий стрибок іноді означає зміну
                 варіанта товару (заміряно 28.07 — «−86%» на кормі виявився саме цим). -->
            <Label Text="⚠ Ми бачимо ціну на сторінці, а не пакування. Різкий стрибок іноді означає, що крамниця показала інший варіант того самого товару."
                   Style="{StaticResource Caption}" />

            <Label Text="{Binding SummaryText}" Style="{StaticResource Caption}"
                   IsVisible="{Binding SummaryText, Converter={StaticResource NotEmpty}}" />
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />
            <!-- Помилка без виходу — глухий кут: заміряно 2026-07-29, кнопки
                 «повторити» не було НІ на сайті, ні в застосунку. Та сама дія, що
                 привела до помилки, має бути доступна одним дотиком. -->
            <Button Text="Спробувати ще раз" Command="{Binding LoadCommand}"
                    Margin="12,0,12,8" HorizontalOptions="Center"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <!-- Той самий патерн, що вже працює в HomePage: поріг у пʼять карток
                 і команда дозавантаження. Доти екран показував рівно перші 50
                 позицій назавжди, хоча сервер віддає сторінки. -->
            <CollectionView ItemsSource="{Binding Items}"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MeasuredDrop">
                        <Border Style="{StaticResource Card}" Padding="12,8" Margin="12,4">
                            <Border.Behaviors>
                                <beh:PressFeedback />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenDropCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <!-- ⚠ РОЗМІР ОБОВʼЯЗКОВИЙ. Колонка «Auto» сама по собі
                                     розтягується під натуральний розмір картинки, і
                                     фото товару на 1000px розпирало картку на весь
                                     екран — один товар на екран замість десятка.
                                     Побачено на кадрі емулятора 2026-07-29; у HomePage
                                     розмір стояв від початку, тут його не було. -->
                                <Border Grid.Column="0" Style="{StaticResource Thumb}"
                                        WidthRequest="64" HeightRequest="64" Padding="4"
                                        VerticalOptions="Start">
                                    <Grid>
                                        <ctl:GlyphView GlyphKey="box" IsVisible="{Binding NoImage}"
                                                       HeightRequest="28" WidthRequest="28"
                                                       HorizontalOptions="Center" VerticalOptions="Center"
                                                       GlyphColor="{AppThemeBinding Light={StaticResource IndicatorLight}, Dark={StaticResource IndicatorDark}}" />
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFit"
                                               AutomationProperties.IsInAccessibleTree="False" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="{StaticResource F3}" MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Store}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding WhenText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="0">
                                    <!-- PillDiscount — стиль BORDER (пігулка-контейнер),
                                         а не Label: почеплений на Label він валить
                                         застосунок InvalidCastException у
                                         Border.StrokeThicknessChanged. Так само, як у
                                         DetailPage. -->
                                    <Border Style="{StaticResource PillDiscount}" Padding="6,2"
                                            HorizontalOptions="End">
                                        <Label Text="{Binding PctText}" TextColor="White"
                                               FontAttributes="Bold" FontSize="{StaticResource F1}" />
                                    </Border>
                                    <Label Text="{Binding NowGrn}" Style="{StaticResource PriceMain}"
                                           HorizontalOptions="End" />
                                    <Label Text="{Binding WasGrn}" Style="{StaticResource PriceOld}"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center">
                        <Label Text="Знижень за цей проміжок не бачили" FontAttributes="Bold"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="Ми показуємо лише те, що виміряли самі. Спробуй ширший проміжок."
                               Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="Start" Margin="0,20,0,0" />
    </Grid>
</ContentPage>
