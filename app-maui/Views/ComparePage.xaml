<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hapay.Views.ComparePage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Hapay.ViewModels"
    xmlns:models="clr-namespace:Hapay.Models"
    xmlns:conv="clr-namespace:Hapay.Converters"
    x:DataType="vm:CompareViewModel"
    Title="Порівняння">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
    </ContentPage.Resources>

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           VerticalOptions="Center" HorizontalOptions="Center" />
        <Label Text="{Binding Error}" Margin="16" VerticalOptions="Center"
               IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}"
               TextColor="{AppThemeBinding Light={StaticResource DiscountLight}, Dark={StaticResource DiscountDark}}" />

        <!-- обидва напрями скролу: колонок може бути 4, характеристик — багато -->
        <ScrollView Orientation="Both">
            <VerticalStackLayout Padding="12" Spacing="0">

                <!-- шапка: картки товарів у ряд (перша колонка — порожній кут таблиці;
                     ContentView, бо BoxView.Color дефолтно ЧОРНИЙ — прогін 2026-07-25) -->
                <HorizontalStackLayout Spacing="0">
                    <ContentView WidthRequest="104" />
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Products}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CompareProduct">
                                <Border WidthRequest="150" Style="{StaticResource Card}" Padding="8"
                                        StrokeShape="RoundRectangle 12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenProductCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="5">
                                        <Border HeightRequest="80" Padding="5" Style="{StaticResource Thumb}">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit"
                                                   AutomationProperties.IsInAccessibleTree="False" />
                                        </Border>
                                        <Label Text="{Binding Title}" FontSize="12" MaxLines="3"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding PriceGrn}" FontAttributes="Bold" FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                                        <Label Text="{Binding OffersText}" Style="{StaticResource Caption}"
                                               FontSize="11" />
                                        <Label Text="{Binding BadgeText}" FontSize="11" FontAttributes="Bold"
                                               IsVisible="{Binding HasBadge}"
                                               TextColor="{AppThemeBinding Light={StaticResource SaveFgLight}, Dark={StaticResource SaveFgDark}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- плейсхолдер: характеристики ще не зібрані (S12 у вільних слотах) -->
                <Border IsVisible="{Binding ShowSpecsPending}" Style="{StaticResource Card}"
                        Padding="12" Margin="0,12" StrokeShape="RoundRectangle 10" WidthRequest="300">
                    <Label Text="Характеристики цих товарів ще збираються. Порівняння цін і знижок — вище."
                           FontSize="13" Style="{StaticResource Caption}" />
                </Border>

                <!-- таблиця характеристик: рядок = атрибут, колонки = товари -->
                <VerticalStackLayout Spacing="0" IsVisible="{Binding HasSpecs}" Margin="0,10,0,0"
                                     BindableLayout.ItemsSource="{Binding SpecRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SpecRow">
                            <HorizontalStackLayout Spacing="8" Padding="0,7">
                                <Label Text="{Binding Name}" WidthRequest="104" FontSize="12"
                                       FontAttributes="Bold" LineBreakMode="WordWrap"
                                       VerticalOptions="Center" />
                                <HorizontalStackLayout Spacing="8"
                                                       BindableLayout.ItemsSource="{Binding Display}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}" WidthRequest="150" FontSize="12"
                                                   LineBreakMode="WordWrap" VerticalOptions="Center" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
